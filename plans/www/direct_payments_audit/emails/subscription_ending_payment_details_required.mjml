<!--
  AFS_DIRECT_PAYMENTS_MODIFIER_ADDITION — plans/www/direct_payments_audit/15-default-emails.md §15.3.
  Default email body: subscription_ending_payment_details_required. Final notice when a closing date passed without new payment details.
  A fragment only: DefaultEmailTemplates::mjml() places it in the dp_body slot of _layout.mjml.
-->
    <mj-section padding="20px 0 0 0">
      <mj-column>
        <mj-text font-family="Inter, Helvetica, Arial, sans-serif" font-size="22px" font-weight="700" line-height="30px" color="#111827" padding="0px 32px">Your subscription is ending</mj-text>
        <mj-text font-family="Inter, Helvetica, Arial, sans-serif" font-size="15px" line-height="24px" color="#374151" padding="16px 32px 0px 32px">
            <p style="margin:0 0 12px 0;">${dp_greeting}</p>
            <p style="margin:0 0 12px 0;">We asked you to update your payment details for <strong>${plan_name}</strong> by ${closing_date}, and we haven't received them yet. Your subscription will end on ${access_ends_at}.</p>
            <p style="margin:0 0 12px 0;">You can still keep it: update your payment details and your subscription continues without starting over.</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="8px 0 0 0">
      <mj-column>
        <mj-button href="${renewal_url}" align="left" background-color="${dp_brand_color}" color="#ffffff" font-family="Inter, Helvetica, Arial, sans-serif" font-size="15px" font-weight="600" border-radius="6px" inner-padding="14px 28px" padding="20px 32px 0px 32px">Keep my subscription</mj-button>
        <mj-text font-family="Inter, Helvetica, Arial, sans-serif" font-size="13px" line-height="20px" color="#6b7280" padding="12px 32px 0px 32px">
          <p style="margin:0;">Button not working? Copy this link into your browser:<br/><a href="${renewal_url}" style="color:${dp_brand_color}; word-break:break-all;">${renewal_url}</a></p>
        </mj-text>
      </mj-column>
    </mj-section>
