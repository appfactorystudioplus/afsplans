<!--
  AFS_DIRECT_PAYMENTS_MODIFIER_ADDITION — plans/www/direct_payments_audit/15-default-emails.md §15.3.
  Default email body: subscription_updated. Confirms a plan change.
  A fragment only: DefaultEmailTemplates::mjml() places it in the dp_body slot of _layout.mjml.
-->
    <mj-section padding="20px 0 0 0">
      <mj-column>
        <mj-text font-family="Inter, Helvetica, Arial, sans-serif" font-size="22px" font-weight="700" line-height="30px" color="#111827" padding="0px 32px">Your subscription has changed</mj-text>
        <mj-text font-family="Inter, Helvetica, Arial, sans-serif" font-size="15px" line-height="24px" color="#374151" padding="16px 32px 0px 32px">
            <p style="margin:0 0 12px 0;">${dp_greeting}</p>
            <p style="margin:0 0 12px 0;">Your subscription is now <strong>${plan_name}</strong>.</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="4px 0 0 0">
      <mj-column>
        <mj-table font-family="Inter, Helvetica, Arial, sans-serif" font-size="14px" line-height="20px" color="#374151" padding="4px 32px 0px 32px">
          <tr style="border-bottom:1px solid #f3f4f6;"><td style="padding:9px 0; color:#6b7280;">New plan</td><td style="padding:9px 0; text-align:right; font-weight:600; color:#111827;">${plan_name}</td></tr>
          <tr style="border-bottom:1px solid #f3f4f6;"><td style="padding:9px 0; color:#6b7280;">Amount</td><td style="padding:9px 0; text-align:right; font-weight:600; color:#111827;">${amount}</td></tr>
          <tr style="border-bottom:1px solid #f3f4f6;"><td style="padding:9px 0; color:#6b7280;">Next payment</td><td style="padding:9px 0; text-align:right; font-weight:600; color:#111827;">${next_charge_date}</td></tr>
        </mj-table>
      </mj-column>
    </mj-section>
    <mj-section padding="8px 0 0 0">
      <mj-column>
        <mj-button href="${manage_subscription_url}" align="left" background-color="${dp_brand_color}" color="#ffffff" font-family="Inter, Helvetica, Arial, sans-serif" font-size="15px" font-weight="600" border-radius="6px" inner-padding="14px 28px" padding="20px 32px 0px 32px">Manage subscription</mj-button>
      </mj-column>
    </mj-section>
