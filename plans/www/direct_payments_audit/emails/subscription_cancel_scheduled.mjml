<!--
  AFS_DIRECT_PAYMENTS_MODIFIER_ADDITION — plans/www/direct_payments_audit/15-default-emails.md §15.3.
  Default email body: subscription_cancel_scheduled. Confirms a cancellation that takes effect at the end of the paid period.
  A fragment only: DefaultEmailTemplates::mjml() places it in the dp_body slot of _layout.mjml.
-->
    <mj-section padding="20px 0 0 0">
      <mj-column>
        <mj-text font-family="Inter, Helvetica, Arial, sans-serif" font-size="22px" font-weight="700" line-height="30px" color="#111827" padding="0px 32px">Your subscription will end</mj-text>
        <mj-text font-family="Inter, Helvetica, Arial, sans-serif" font-size="15px" line-height="24px" color="#374151" padding="16px 32px 0px 32px">
            <p style="margin:0 0 12px 0;">${dp_greeting}</p>
            <p style="margin:0 0 12px 0;">We've received your request to cancel <strong>${plan_name}</strong>. You won't be charged again, and you keep your access until ${access_ends_at}.</p>
            <p style="margin:0 0 12px 0;">Changed your mind? You can keep your subscription any time before then.</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="8px 0 0 0">
      <mj-column>
        <mj-button href="${manage_subscription_url}" align="left" background-color="${dp_brand_color}" color="#ffffff" font-family="Inter, Helvetica, Arial, sans-serif" font-size="15px" font-weight="600" border-radius="6px" inner-padding="14px 28px" padding="20px 32px 0px 32px">Manage subscription</mj-button>
      </mj-column>
    </mj-section>
