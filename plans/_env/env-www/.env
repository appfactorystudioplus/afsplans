# =============================================================================
# afs-connect additions for apps/www/.env (Brain only)
#
# Merge these into the main www .env — do NOT duplicate vars already there
# (BRAIN_API_URL, DB_*, CHECKPOINT_BASE_URL, APP_ENV, etc.).
#
# Example tenant: example.com → x1sexample7k2m9.sites.appfactory.studio
# See: 07-www-env-variables.md | Pair with: env-coord/.env
# =============================================================================

AFS_CONNECT_APP_NAME=www
AFS_CONNECT_SERVICE_KEY=afs_www_example_key_replace_with_random_32chars
AFS_CONNECT_SERVICE_KEY_COORDINATOR=afs_coord_example_key_replace_with_random_32
AFS_CONNECT_SERVICE_KEY_WWW=afs_www_example_key_replace_with_random_32chars
AFS_CONNECT_SERVICE_KEY_MEMBERS=afs_members_example_key_replace_random_32ch

AFS_CONNECT_COORDINATOR_URL=https://coordinator15.appfactory.studio

# afs_connect.php reads CHECKPOINT_URL (not CHECKPOINT_BASE_URL)
CHECKPOINT_URL=https://auth15.appfactory.studio

MEMBERS_API_URL=https://members15.appfactory.studio

AFS_SITES_BASE_DOMAIN=sites.appfactory.studio

# Optional
AFS_CONNECT_TIMESTAMP_SKEW=300
AFS_CONNECT_DEV_ENABLED=false
