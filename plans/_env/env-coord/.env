# =============================================================================
# afs-connect additions for apps/coordinator/.env
#
# Merge these into the main coordinator .env — do NOT duplicate vars already
# there (BRAIN_API_URL, DB_*, CHECKPOINT_BASE_URL, APP_ENV, etc.).
#
# Example indexed site: example.com → x1sexample7k2m9.sites.appfactory.studio
# See: 10-coordinator-env-variables.md | Pair with: env-www/.env
# =============================================================================

AFS_CONNECT_APP_NAME=coordinator
AFS_CONNECT_SERVICE_KEY=afs_coord_example_key_replace_with_random_32
AFS_CONNECT_SERVICE_KEY_COORDINATOR=afs_coord_example_key_replace_with_random_32
AFS_CONNECT_SERVICE_KEY_NOTES=afs_notes_example_key_replace_with_random_32ch
AFS_CONNECT_SERVICE_KEY_DREAM_GRAPH=afs_dgraph_example_key_replace_random_32c
AFS_CONNECT_SERVICE_KEY_FLOW=afs_flow_example_key_replace_with_random_32ch
AFS_CONNECT_SERVICE_KEY_PDF_EDITOR=afs_pdfed_example_key_replace_random_32ch
AFS_CONNECT_SERVICE_KEY_MEMBERS=afs_members_example_key_replace_random_32ch
AFS_CONNECT_SERVICE_KEY_WWW=afs_www_example_key_replace_with_random_32chars

# afs_connect.php reads CHECKPOINT_URL (not CHECKPOINT_BASE_URL)
CHECKPOINT_URL=https://auth15.appfactory.studio

MEMBERS_API_URL=https://members15.appfactory.studio

AFS_SITES_BASE_DOMAIN=sites.appfactory.studio

# Optional
AFS_CONNECT_TIMESTAMP_SKEW=300
AFS_CONNECT_GLOBAL_ENABLED=true

AFS_CONNECT_NOTES_BASE_URL=https://notes.dev.appfactory.studio/api/internal/afs-connect/v1
AFS_CONNECT_FLOW_BASE_URL=https://flow.dev.appfactory.studio/api/internal/afs-connect/v1
AFS_CONNECT_DREAM_GRAPH_BASE_URL=https://graphs.dev.appfactory.studio/api/internal/afs-connect/v1
AFS_CONNECT_PDF_EDITOR_BASE_URL=https://pdfeditor.dev.appfactory.studio/api/internal/afs-connect/v1
